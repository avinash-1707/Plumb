{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plumb:/schemas/knowledge/runtime.json",
  "title": "Runtime findings (.plumb/knowledge/runtime.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agent",
    "install",
    "runTargets",
    "services",
    "env",
    "seed",
    "auth",
    "unknowns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "agent": {
      "const": "explorer-runtime"
    },
    "install": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "evidence",
            "confidence"
          ],
          "properties": {
            "command": {
              "$ref": "../common.json#/$defs/commandRef"
            },
            "evidence": {
              "$ref": "../common.json#/$defs/evidence"
            },
            "confidence": {
              "$ref": "../common.json#/$defs/confidence"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "runTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start",
          "port",
          "portEnv",
          "ready",
          "evidence",
          "confidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "$ref": "../common.json#/$defs/commandRef"
          },
          "port": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "portEnv": {
            "type": [
              "string",
              "null"
            ]
          },
          "ready": {
            "$ref": "../profile.json#/$defs/readinessProbe"
          },
          "evidence": {
            "$ref": "../common.json#/$defs/evidence"
          },
          "confidence": {
            "$ref": "../common.json#/$defs/confidence"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "start",
          "stop",
          "ready",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "docker-compose",
              "local",
              "external"
            ]
          },
          "start": {
            "oneOf": [
              {
                "$ref": "../common.json#/$defs/commandRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "stop": {
            "oneOf": [
              {
                "$ref": "../common.json#/$defs/commandRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "ready": {
            "oneOf": [
              {
                "$ref": "../profile.json#/$defs/readinessProbe"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "$ref": "../common.json#/$defs/evidence"
          }
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required",
          "secret",
          "defaultForVerification",
          "source",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "defaultForVerification": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "enum": [
              "env-example",
              "code",
              "compose"
            ]
          },
          "evidence": {
            "$ref": "../common.json#/$defs/evidence"
          }
        }
      }
    },
    "seed": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "evidence"
          ],
          "properties": {
            "command": {
              "$ref": "../common.json#/$defs/commandRef"
            },
            "evidence": {
              "$ref": "../common.json#/$defs/evidence"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "notes",
            "evidence"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            },
            "evidence": {
              "$ref": "../common.json#/$defs/evidence"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/knowledgeUnknown"
      }
    }
  }
}
