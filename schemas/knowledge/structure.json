{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plumb:/schemas/knowledge/structure.json",
  "title": "Structure findings (.plumb/knowledge/structure.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agent",
    "languages",
    "buildSystem",
    "components",
    "splitProposals",
    "generatedPaths",
    "unknowns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "agent": {
      "const": "explorer-structure"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "../common.json#/$defs/evidence"
          }
        }
      }
    },
    "buildSystem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "evidence"
          ],
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "../common.json#/$defs/evidence"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "build",
          "test",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^component:.+$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "build": {
            "oneOf": [
              {
                "$ref": "../common.json#/$defs/commandRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "test": {
            "oneOf": [
              {
                "$ref": "../common.json#/$defs/commandRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "$ref": "../common.json#/$defs/evidence"
          }
        }
      }
    },
    "splitProposals": {
      "description": "Only for single-package repos whose import graph splits cleanly.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "include",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "include": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "../common.json#/$defs/evidence"
          }
        }
      }
    },
    "generatedPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "glob",
          "evidence"
        ],
        "properties": {
          "glob": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "../common.json#/$defs/evidence"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "../common.json#/$defs/knowledgeUnknown"
      }
    }
  }
}
