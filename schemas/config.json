{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plumb:/schemas/config.json",
  "title": "Plumb config (.plumb/config.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "strategy": { "$ref": "common.json#/$defs/strategy" },
    "components": {
      "description": "Explicit component overrides.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "include"],
        "properties": {
          "id": {
            "description": "Bare component name; the map id is component:<id>.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "ignore": { "description": "Globs excluded from map and gate.", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "deepIgnore": { "description": "Globs whose changes never require a live verification. The fast gate still runs on them.", "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sessionDigest": { "description": "Add the map digest to each Claude Code session's context (default true).", "type": "boolean" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smoke": { "type": "boolean" },
        "budgetSec": { "type": "integer", "minimum": 1 }
      }
    },
    "review": {
      "description": "v2.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concerns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["architecture", "resilience", "concurrency", "resources"] }
        },
        "blockAt": { "enum": ["critical", "high", "medium"] },
        "maxAgents": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
