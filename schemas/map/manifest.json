{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plumb:/schemas/map/manifest.json",
  "title": "Plumb map manifest (.plumb/map/manifest.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "builtAtCommit", "extractors", "components", "unassignedFiles", "extractorFailures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "builtAtCommit": {
      "description": "HEAD when the map was last fully consistent. SHA-1 or SHA-256 object name.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "extractors": {
      "description": "Extractor id to version; bumping a version forces re-extraction of the facts it owns.",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^component:.+$" }
    },
    "unassignedFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "extractorFailures": {
      "type": "array",
      "items": { "$ref": "#/$defs/extractorFailure" }
    }
  },
  "$defs": {
    "extractorFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "component", "reason", "fallback"],
      "properties": {
        "extractor": { "type": "string", "minLength": 1 },
        "component": {
          "oneOf": [{ "type": "string", "pattern": "^component:.+$" }, { "type": "null" }]
        },
        "reason": { "type": "string", "minLength": 1 },
        "fallback": { "enum": ["tree-sitter", "none"] }
      }
    }
  }
}
